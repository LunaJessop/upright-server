DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string
PORT=3001

# Stripe (server only — never put the secret key in the Next.js app)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly $25/mo (STRIPE_PRICE_ID kept as alias)
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_MONTHLY=price_...
# Yearly $250/yr — create in Stripe Dashboard and paste here
STRIPE_PRICE_ID_YEARLY=price_...
# Browser origin of the Next.js app. CORS allows this origin (no wildcard).
# Vercel production must be exactly: https://uprightmrp.netlify.app
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra browser origins (exact origins, no wildcards).
# http://localhost:3000 is always allowed for local dev.
# CORS_EXTRA_ORIGINS=https://staging.example.com
# Opt in to Netlify deploy-preview URLs for the site in FRONTEND_URL only
# (https://deploy-preview-<id>--<site>.netlify.app). Leave unset to deny them.
# Does not allow other *.netlify.app sites or branch deploys.
# CORS_ALLOW_NETLIFY_PREVIEWS=true
BILLING_GRACE_DAYS=7

# Comma-separated user emails that can access GET /api/admin/clients and /admin
PLATFORM_ADMIN_EMAILS=you@example.com
