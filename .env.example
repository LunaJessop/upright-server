DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string
PORT=3001

# Stripe (server only — never put the secret key in the Next.js app)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly $25/mo (STRIPE_PRICE_ID kept as alias)
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_MONTHLY=price_...
# Yearly $250/yr — create in Stripe Dashboard and paste here
STRIPE_PRICE_ID_YEARLY=price_...
# Transactional email. Gmail is used when both of these are set. Otherwise
# Resend is used when RESEND_API_KEY is set. If neither is set, the server
# logs the message and does not send it. Sending never throws.
# Gmail app password: turn on 2-Step Verification for the Google account,
# open https://myaccount.google.com/apppasswords, create a password named
# Upright, and paste the 16 letters here. Spaces are fine.
# GMAIL_USER=uprightmrp@gmail.com
# GMAIL_APP_PASSWORD=
# Reply-To. Defaults to uprightmrp@gmail.com when unset.
# SUPPORT_EMAIL=uprightmrp@gmail.com
# Resend is the fallback when Gmail is not configured.
RESEND_API_KEY=
# From address for Resend only. Gmail sends as Upright <GMAIL_USER>.
# EMAIL_FROM=Upright <hello@yourdomain.com>

# Browser origin of the Next.js app. CORS allows this origin (no wildcard).
# Vercel production must be exactly: https://uprightmrp.netlify.app
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra browser origins (exact origins, no wildcards).
# http://localhost:3000 is added automatically only when NODE_ENV is not production.
# CORS_EXTRA_ORIGINS=https://staging.example.com
# Opt in to Netlify deploy-preview URLs for the site in FRONTEND_URL only
# (https://deploy-preview-<id>--<site>.netlify.app). Leave unset to deny them.
# Does not allow other *.netlify.app sites or branch deploys.
# CORS_ALLOW_NETLIFY_PREVIEWS=true
BILLING_GRACE_DAYS=7

# Comma-separated user emails that can access GET /api/admin/clients and /admin
PLATFORM_ADMIN_EMAILS=you@example.com

# Optional credentials for scripts/seed-dev-user.js (local databases only).
# Email defaults to dev-founder@localhost. If the password is omitted, the
# script generates one and prints it once. It must be 8+ characters and
# include an uppercase letter and a symbol.
# The script refuses to run when NODE_ENV=production, VERCEL is set, or
# DATABASE_URL is not a local database.
# SEED_DEV_EMAIL=dev-founder@localhost
# SEED_DEV_PASSWORD=
